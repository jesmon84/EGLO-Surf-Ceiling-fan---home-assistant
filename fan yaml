  
uart:
  id: tuya_uart
  tx_pin: GPIO5
  rx_pin: GPIO4
  baud_rate: 9600
tuya:
  id: fan_tuya

fan:
  - platform: tuya
    name: "Ergo Fan"
    switch_datapoint: 60
    speed_datapoint: 62
    speed_count: 5
    direction_datapoint: 63

light:
  - platform: tuya
    name: "Ergo Fan Light"
    switch_datapoint: 20
    dimmer_datapoint: 22
    min_value: 100
    max_value: 1000
    color_temperature_datapoint: 23
    color_temperature_invert: true
    color_temperature_max_value: 1000
    cold_white_color_temperature: 153 mireds
    warm_white_color_temperature: 500 mireds

select:
  - platform: tuya
    name: "Ergo Fan Mode"
    enum_datapoint: 61
    optimistic: true
    options:
      0: "Normal"
      1: "Natural" 
